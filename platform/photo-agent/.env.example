# platform/photo-agent — client .env template
# Copy to clients/<client>/src/photo-agent/.env and fill in all values.
# NEVER commit .env to version control.
# After creating .env: chmod 600 .env

# ---------------------------------------------------------------------------
# Machine identity — also set in fieldkit/.env (root)
# ---------------------------------------------------------------------------

# Do NOT set CLIENT_NAME here. It is resolved before this file is loaded —
# from the root fieldkit/.env, or from a CLIENT_NAME already set on the
# invoking process (see issue #45 and platform/docs/hermes/05-cron-
# verification.md) — and the resolving script re-asserts that value
# immediately after loading this file, so a CLIENT_NAME defined here would
# be silently ignored rather than silently honored.

# ---------------------------------------------------------------------------
# Data and log paths — REQUIRED by platform scripts (RuntimeError if unset)
# ---------------------------------------------------------------------------

# Absolute path to this client's data directory.
# Platform scripts append /photo-agent/ internally.
FIELDKIT_DATA_DIR=/path/to/fieldkit/clients/<client>/data

# Absolute path to this client's log directory.
# Platform scripts write to $FIELDKIT_LOG_DIR/photo-agent.log.
FIELDKIT_LOG_DIR=/path/to/fieldkit/clients/<client>/logs

# ---------------------------------------------------------------------------
# Email — approval notification
# ---------------------------------------------------------------------------

# Gmail address the agent uses to send the approval email
AGENT_EMAIL=  # required

# Recipient of the approval email
ADMIN_EMAIL=  # required

# ---------------------------------------------------------------------------
# Telegram — approval commands and admin alerts
# ---------------------------------------------------------------------------

# Admin's Telegram chat ID (find via @userinfobot). For a private DM,
# Telegram's chat_id is the admin's own user id.
ADMIN_TELEGRAM_CHAT_ID=  # required

# Telegram bot token — used for BOTH Hermes's gateway (conversational
# commands, including /photo_approve and /photo_reject) AND the
# approval-request/outcome messages. One bot per client is all that's
# needed: issue #49 replaced the inline Approve/Reject buttons with plain
# Hermes commands dispatched through Hermes's own gateway poller, retiring
# the second, dedicated TELEGRAM_APPROVAL_BOT_TOKEN that issue #29
# originally required to avoid a getUpdates offset race between two
# pollers on the same token. See
# platform/docs/hermes/10-text-based-approval-migration.md.
TELEGRAM_BOT_TOKEN=  # required

# ---------------------------------------------------------------------------
# Google Drive
# ---------------------------------------------------------------------------

# Google Drive ID of the root project folder
DRIVE_ROOT_FOLDER_ID=  # required

# Path to Drive OAuth credentials JSON (ADC format: client_id, client_secret, refresh_token).
# Default: ~/.config/gws/user_credentials.json
# GOOGLE_USER_CREDENTIALS_FILE=~/.config/gws/user_credentials.json

# ---------------------------------------------------------------------------
# Video generation
# ---------------------------------------------------------------------------

# Display duration per photo in seconds (default: 4)
SECONDS_PER_PHOTO=4

# Local temp directory for downloaded photos and the generated video
# Relative paths are resolved against FIELDKIT_ROOT.
VIDEO_TMP_DIR=data/photo-agent/tmp

# ---------------------------------------------------------------------------
# Facebook Page connection (optional — skip if this client does not post to Facebook)
# FB_APP_ID and FB_APP_SECRET are used ONLY by generate_auth_link.py (one-time admin).
# FB_PAGE_ID and FB_PAGE_ACCESS_TOKEN are written automatically by generate_auth_link.py.
# ---------------------------------------------------------------------------

# FB_APP_ID=
# FB_APP_SECRET=
# FB_PAGE_ID=
# FB_PAGE_ACCESS_TOKEN=
# FB_REDIRECT_URI=http://localhost:8080/callback
