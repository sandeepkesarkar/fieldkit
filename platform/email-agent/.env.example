# .env.example — Email Agent configuration template
#
# Copy this file to .env on the Mac Mini and fill in each value:
#   cp .env.example .env
#
# The .env file is never committed to the repo. It lives only on the Mac Mini
# at ~/fieldkit/platform/email-agent/.env. How it is sourced at runtime (manually,
# via OpenClaw config, or shell profile) is confirmed during T05 setup.

# ---------------------------------------------------------------------------
# Gmail
# ---------------------------------------------------------------------------

# The dedicated Gmail address the agent monitors for incoming job emails.
AGENT_EMAIL=fieldkit.agent@gmail.com

# Comma-separated list of permitted sender addresses. Emails from any other
# address are logged as REJECTED and discarded without a Telegram notification.
# Whitespace around commas is trimmed; matching is case-insensitive.
# Multiple senders: admin@mybusiness.com,ops@mybusiness.com
ADMIN_ALLOWLIST=admin@mybusiness.com

# ---------------------------------------------------------------------------
# Polling
# ---------------------------------------------------------------------------

# How often the agent checks Gmail, in minutes. Controls the cron schedule
# generated during setup. Must be a positive integer. Production default: 5.
POLLING_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Telegram
# NOTE: Verify during T05 whether these belong here or are managed at the
# OpenClaw level (its own config). Update this file after T05 confirms.
# ---------------------------------------------------------------------------

# Telegram bot token issued by BotFather for the FieldKit notification bot.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID of the admin who receives incoming job notifications.
ADMIN_TELEGRAM_CHAT_ID=
