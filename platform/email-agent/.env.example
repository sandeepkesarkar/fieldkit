# .env.example — Email Agent configuration template
#
# Copy this file to .env on the Mac Mini and fill in each value:
#   cp .env.example .env
#
# The .env file is never committed to the repo. It lives only on the Mac Mini
# at ~/src/fieldkit/platform/email-agent/.env and is read at runtime by the script.

# ---------------------------------------------------------------------------
# Gmail
# ---------------------------------------------------------------------------

# The dedicated Gmail address the agent monitors for incoming job emails.
AGENT_EMAIL=fieldkit.agent@gmail.com

# Force gws to use file-based credential storage instead of the macOS keychain.
# Required for cron: the keychain is not accessible without a user session.
# Must be set before running `gws auth login` and kept in .env for runtime use.
GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file

# Comma-separated list of permitted sender addresses. Emails from any other
# address are logged as REJECTED and discarded without a Telegram notification.
# Whitespace around commas is trimmed; matching is case-insensitive.
# Multiple senders: admin@mybusiness.com,ops@mybusiness.com
ADMIN_ALLOWLIST=admin@mybusiness.com

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# The Telegram chat ID of the admin who receives email notifications.
# Find it in the Hermes gateway logs: look for "telegram sendMessage ok chat=<id>"
# in ~/.hermes/logs/gateway.log, or send a message to the bot and check there.
ADMIN_TELEGRAM_CHAT_ID=000000000

# Telegram bot token — required for direct Bot API calls (tools/telegram_api.py).
# Same bot token used by Hermes's gateway; see ~/.hermes/.env on the Mac Mini.
TELEGRAM_BOT_TOKEN=
