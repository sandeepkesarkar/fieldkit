# Photo-Video Agent — environment variables (venus, OpenAI-backed demo client)
# Copy this file to .env and fill in all values before running any script.
# NEVER commit .env to version control.
# After creating .env, set restrictive permissions: chmod 600 .env
#
# This file is intentionally identical in shape to _demo's .env.example —
# venus's whole purpose is to prove that swapping the model provider (see
# ../../README.md#provider-configuration) requires no change here. Every
# value below must be venus's own (a separate Google account, separate
# Telegram bots, separate Facebook page) — none of it is shared with _demo
# or mercury.

# Gmail address the agent uses to send the approval email (separate Gmail account from other clients)
AGENT_EMAIL=  # required

# Recipient of the approval email
ADMIN_EMAIL=  # required

# Admin's Telegram chat ID (find your chat ID via @userinfobot). A private
# DM's chat_id is the admin's own user id.
ADMIN_TELEGRAM_CHAT_ID=  # required

# Telegram bot token — used for BOTH Hermes's gateway (conversational
# commands: /process_photos, /photo_approve, /photo_reject) AND the
# approval-request/outcome messages. Must be a NEW bot (separate BotFather
# registration) — this is the bot bound to the "venus" Hermes profile, whose
# model calls go to OpenAI. See ../../README.md#provider-configuration.
# One bot per client is all that's needed: issue #49 retired the second,
# dedicated TELEGRAM_APPROVAL_BOT_TOKEN that issue #29 originally required.
# See platform/docs/hermes/10-text-based-approval-migration.md.
TELEGRAM_BOT_TOKEN=  # required

# Google Drive ID of the root project folder (separate Drive folder from other clients)
DRIVE_ROOT_FOLDER_ID=  # required

# Display duration per photo in seconds (default: 4)
SECONDS_PER_PHOTO=4

# Local temp directory for downloaded photos and the generated video.
# Leave unset (commented out) to default to <FIELDKIT_DATA_DIR>/photo-agent/tmp,
# which keeps each client's tmp files isolated from other clients.
#VIDEO_TMP_DIR=data/photo-agent/tmp

# Path to Drive OAuth credentials JSON (ADC format — client_id, client_secret, refresh_token).
# Default: ~/.config/gws/user_credentials.json — use a venus-specific path if
# running gws for multiple clients on the same machine, e.g. ~/.config/gws-venus/user_credentials.json
# Create once after gws auth login:
#   ( umask 077 && gws auth export 2>/dev/null | python3 -c "
#     import sys, json; raw = sys.stdin.read()
#     print(json.dumps(json.loads(raw[raw.find('{'):]), indent=2))
#   " > ~/.config/gws-venus/user_credentials.json )
# (umask 077 means the file is created 600 from the first write — no window
# where the refresh token is readable by other local users, unlike a
# create-then-chmod sequence)
# GOOGLE_USER_CREDENTIALS_FILE=~/.config/gws-venus/user_credentials.json

# Client-scoped data directory — required; platform scripts raise RuntimeError if unset
# Set to an absolute path under this client's data/ folder
FIELDKIT_DATA_DIR=/path/to/fieldkit/clients/venus/data

# Client-scoped log directory — required; platform scripts raise RuntimeError if unset
# Set to an absolute path under this client's logs/ folder
FIELDKIT_LOG_DIR=/path/to/fieldkit/clients/venus/logs

# Operational note: logs/photo-agent.log is append-only and unbounded.
# Rotate manually or configure logrotate if disk space is a concern.

# ---------------------------------------------------------------------------
# Facebook Page connection — Feature 003
# FB_APP_ID and FB_APP_SECRET are used ONLY by generate_auth_link.py (admin, one-time).
# FB_PAGE_ID and FB_PAGE_ACCESS_TOKEN are written automatically by generate_auth_link.py.
# ---------------------------------------------------------------------------

# Meta Developer App ID (required before running generate_auth_link.py) — can
# reuse an existing Meta Developer App across clients; the Page below must
# still be venus's own
FB_APP_ID=

# Meta Developer App secret (required before running generate_auth_link.py; never used by cron)
FB_APP_SECRET=

# Facebook Page ID — written by generate_auth_link.py (numeric string, e.g. 123456789)
# Must be a separate Page from every other client's
FB_PAGE_ID=

# Permanent Facebook Page access token — written by generate_auth_link.py; used by upload cron
FB_PAGE_ACCESS_TOKEN=

# OAuth redirect URI — override if using a port other than 8080
# FB_REDIRECT_URI=http://localhost:8080/callback
