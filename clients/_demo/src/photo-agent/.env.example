# Photo-Video Agent — environment variables
# Copy this file to .env and fill in all values before running any script.
# NEVER commit .env to version control.

# Gmail address the agent uses to send the approval email
AGENT_EMAIL=  # required

# Recipient of the approval email
ADMIN_EMAIL=  # required

# Admin's Telegram chat ID (find your chat ID via @userinfobot)
ADMIN_TELEGRAM_CHAT_ID=  # required

# Telegram bot token — required; OpenClaw does not expose this for script use
TELEGRAM_BOT_TOKEN=  # required

# Google Drive ID of the root project folder
DRIVE_ROOT_FOLDER_ID=  # required

# Display duration per photo in seconds (default: 4)
SECONDS_PER_PHOTO=4

# Local temp directory for downloaded photos and the generated video
VIDEO_TMP_DIR=data/photo-agent/tmp

# Optional: override default data directory (default: <repo-root>/data)
# FIELDKIT_DATA_DIR=

# Optional: override default log directory (default: <repo-root>/logs)
# FIELDKIT_LOG_DIR=
