# _construction_co — photo-agent environment variables
# Copy to .env and fill in all values before running any script.
# NEVER commit .env to version control.
# After creating .env: chmod 600 .env
#
# Pipeline scope for _construction_co: video generation → Telegram approval only.
# No Facebook integration — omit all FB_* variables.

# ---------------------------------------------------------------------------
# Data and log paths — REQUIRED
# ---------------------------------------------------------------------------

FIELDKIT_DATA_DIR=/path/to/fieldkit/clients/_construction_co/data
FIELDKIT_LOG_DIR=/path/to/fieldkit/clients/_construction_co/logs

# ---------------------------------------------------------------------------
# Email — approval notification (separate Gmail account from _demo)
# ---------------------------------------------------------------------------

AGENT_EMAIL=   # required — _construction_co agent Gmail address
ADMIN_EMAIL=   # required — recipient of approval email

# ---------------------------------------------------------------------------
# Telegram — approval commands and admin alerts (separate bot from _demo)
# ---------------------------------------------------------------------------

ADMIN_TELEGRAM_CHAT_ID=   # required
TELEGRAM_BOT_TOKEN=       # required — Hermes gateway bot, separate from _demo.
                           # Used for BOTH Hermes's gateway (including
                           # /photo_approve and /photo_reject) AND the
                           # approval-request/outcome messages — one bot per
                           # client is all that's needed since issue #49
                           # retired the second, dedicated
                           # TELEGRAM_APPROVAL_BOT_TOKEN that issue #29
                           # originally required. See
                           # platform/docs/hermes/10-text-based-approval-migration.md.

# ---------------------------------------------------------------------------
# Google Drive (separate Google account from _demo)
# ---------------------------------------------------------------------------

DRIVE_ROOT_FOLDER_ID=   # required — separate Drive folder

# GOOGLE_USER_CREDENTIALS_FILE=~/.config/gws-construction/user_credentials.json

# ---------------------------------------------------------------------------
# Video generation
# ---------------------------------------------------------------------------

SECONDS_PER_PHOTO=4
VIDEO_TMP_DIR=data/photo-agent/tmp

# ---------------------------------------------------------------------------
# Facebook — NOT used by _construction_co
# Pipeline scoped to video → Telegram approval only; no FB upload.
# Leave all FB_* variables unset (or commented out).
# ---------------------------------------------------------------------------
# FB_APP_ID=
# FB_APP_SECRET=
# FB_PAGE_ID=
# FB_PAGE_ACCESS_TOKEN=
