# macOS
.DS_Store
.DS_Store?
._*

# Runtime data (lives on Mac Mini, never committed)
data/
logs/
*.json.bak

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Environment — copy from .env.example, never commit the real thing
.env
.env.bak
!.env.example

# Omnigent per-session Codex home (auth.json copy, sqlite state) — created
# by `omnigent run --harness codex` invocations in this directory
.codex-tmp/

# Omnigent project config — machine-local because default_agent must be an
# absolute path. Copy .omnigent/config.example.yaml to create it.
.omnigent/config.yaml


# Editor
.vscode/
.idea/
*.swp
*.swo

# Nested git worktrees (e.g. .worktrees/<branch>/) — never part of a commit.
# Not a substitute for the tracked-files scoping in
# test_no_stale_repo_path_in_current_docs: that test uses `git ls-files` so no
# untracked directory can affect it, ignored or not.
.worktrees/
